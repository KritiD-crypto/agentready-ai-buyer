# GEMINI_API_KEY: Required for Gemini AI API calls and LLM reasoning layer.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Project URL for Supabase PostgreSQL database and Auth.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Client-safe public key for Supabase.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret key for privileged DB operations and RLS bypass.
SUPABASE_SERVICE_ROLE_KEY=""

# RAZORPAY_KEY_ID: Razorpay API Key ID for payments and Agentic Commerce Tokens.
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Server-only Razorpay Secret for webhook and HMAC signature verification.
RAZORPAY_KEY_SECRET=""
